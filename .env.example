# PostgreSQL
DB_HOST=192.168.120.98
DB_PORT=5433
DB_NAME=bma_lighting_heatmap
DB_USER=postgres
DB_PASSWORD=ใส่รหัสผ่านฐานข้อมูลที่นี่
DB_SSLMODE=prefer

# สร้างด้วยคำสั่ง: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ใส่ค่าสุ่มอย่างน้อย_32_ตัวอักษร

# ใช้สร้างผู้ดูแลครั้งแรกเท่านั้น หากมี username นี้แล้วระบบจะไม่เปลี่ยนรหัสผ่านเดิม
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=ตั้งรหัสผ่านผู้ดูแลอย่างน้อย_10_ตัวอักษร
APP_ADMIN_DISPLAY_NAME=ผู้ดูแลระบบ

# ใช้ true เมื่อเข้าเว็บผ่าน HTTPS; เปลี่ยนเป็น false เฉพาะการทดสอบผ่าน http://SERVER_IP:1112
SESSION_COOKIE_SECURE=true
